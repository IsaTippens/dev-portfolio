		"autoprefixer": "^10.6.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.0",
		"mdsvex": "^0.11.2",
		"postcss": "^8.5.32",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.3.0",
